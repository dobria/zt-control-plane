# Web UI port is controlled by compose and defaults to 3100 locally.
WEB_PORT=3100
ZT_UDP_PORT=9994
DOCKER_PLATFORM=linux/amd64

# Optional. When omitted, the application creates a persistent encryption key in /data/app.
APP_SECRET=
# Required only for the first administrator. When omitted, a random token is
# created in /data/app/setup.token and printed once to the application log.
APP_SETUP_TOKEN=
# Canonical browser origin. Required whenever TRUST_PROXY=1.
APP_PUBLIC_URL=http://localhost:3100
APP_SECURE_COOKIES=0
SESSION_HOURS=12
# Enable only behind a trusted reverse proxy that overwrites forwarding headers.
TRUST_PROXY=0
# Emergency recovery only. Set to 1 and restart to bypass a saved IP access list.
IP_ALLOWLIST_BYPASS=0

# Used only by the optional embedded-controller Compose overlay.
# The standard open-source image does not contain ZeroTier One.
EMBEDDED_ZEROTIER=0
ZT_LOCAL_API_URL=http://127.0.0.1:9993
ZT_LOCAL_TOKEN_PATH=/var/lib/zerotier-one/authtoken.secret
